<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      CameraX 应用内相机需要此权限；
      运行时会在进入相机页时申请。
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      天气需要按用户实际位置查询。
      只要粗略定位：天气看的是城市级气候，精确到街道没有意义，
      而且只申请粗略定位能让系统弹框更简单（安卓 12+ 不再出现
      「精确/大致」二级选择）。
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Android 13+ 发送通知需要运行时权限 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 真实天气接口（Open-Meteo）需要；失败时自动回退离线模拟数据 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- 定位是可选能力：没有它就用默认城市给出天气。 -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:name=".OotdApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OotdToday">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.OotdToday"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          FileProvider：CameraX 把照片写入应用私有目录后，若需向其它应用
          展示（如分享功能）会用到。当前仅保留声明以备后续分享功能，
          不对外暴露任何目录。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          WorkManager 按需初始化：Application 已实现 Configuration.Provider，
          必须移除 androidx.startup 的默认 InitializationProvider，
          否则 WorkManager 会被初始化两次（lint: RemoveWorkManagerInitializer）。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
